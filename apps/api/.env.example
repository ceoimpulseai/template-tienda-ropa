PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173

# Si se completan DATABASE_URL o DB_HOST/DB_NAME/DB_USER, Sequelize usa Postgres.
# Si no, cae a SQLite local (./dev.sqlite) para desarrollo sin friccion.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=app

# better-auth SIEMPRE requiere Postgres (no soporta el fallback SQLite).
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:4000
